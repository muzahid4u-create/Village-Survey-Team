{
  "buildCommand": "npm --workspace @marda/web run build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/reports/(.*)",
      "destination": "/api/[...path]"
    }
  ],
  "functions": {
    "api/**/*.mjs": {
      "runtime": "@vercel/node@3.2.26",
      "regions": ["sin1"],
      "maxDuration": 30
    }
  }
}
